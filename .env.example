# ─── Indexer / API ────────────────────────────────────────────────────────────

# PostgreSQL connection string
# For local dev: postgresql://postgres:postgres@localhost:5432/nft_lending
# For VPS: postgresql://user:pass@your-vps-ip:5432/nft_lending
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nft_lending

# Yellowstone gRPC endpoint (Helius or Triton)
# Helius: https://mainnet.helius-rpc.com (use your API key as query param)
# Triton: https://your-node.rpcpool.com
GRPC_ENDPOINT=https://mainnet.helius-rpc.com:443

# API key for gRPC provider
GRPC_API_KEY=your_helius_or_triton_api_key

# Your deployed program ID (update after anchor deploy)
PROGRAM_ID=625a3ioDN2HBSGZwpRFKGWcAVSc2XbySBRubDcMKxVjo

# Port for the REST/WebSocket API
API_PORT=8080

# Log level: trace, debug, info, warn, error
RUST_LOG=info

# ─── Crank Bot ────────────────────────────────────────────────────────────────

# Solana RPC endpoint for submitting transactions
# Use Helius free tier (1M txns/month) or your own node
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=your_key

# URL of the indexer API
API_URL=http://localhost:8080

# Path to crank bot keypair (must hold SOL for gas)
CRANK_KEYPAIR_PATH=~/.config/solana/crank-wallet.json

# Log level
LOG_LEVEL=info

# ─── Frontend (prefix with NEXT_PUBLIC_) ─────────────────────────────────────

# Your indexer API URL (the Axum server)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Solana RPC for the frontend wallet adapter (can be a free public endpoint)
# For read-heavy frontend use, Helius free tier is fine
NEXT_PUBLIC_RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Deployed program ID
NEXT_PUBLIC_PROGRAM_ID=625a3ioDN2HBSGZwpRFKGWcAVSc2XbySBRubDcMKxVjo
